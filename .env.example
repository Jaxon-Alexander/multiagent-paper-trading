# Local only. Use paper keys generated from your Alpaca PAPER dashboard.
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
# Market-data keys (Alpaca; may be the same paper keys):
ALPACA_API_KEY=REPLACE_WITH_ALPACA_MARKET_DATA_KEY
ALPACA_SECRET_KEY=REPLACE_WITH_ALPACA_MARKET_DATA_SECRET
# Brokerage keys MUST be from PAPER account (never live account keys):
ALPACA_PAPER_API_KEY=REPLACE_WITH_ALPACA_PAPER_KEY
ALPACA_PAPER_SECRET_KEY=REPLACE_WITH_ALPACA_PAPER_SECRET
# All order writes disabled by default; analysis remains read-only.
ENABLE_PAPER_ORDERS=false
MAX_PAPER_ORDER_NOTIONAL=1000
MAX_PAPER_POSITION_PCT=20
